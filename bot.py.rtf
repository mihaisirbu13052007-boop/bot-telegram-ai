\
    if query.data == "get_risks":\
        risk_text = (\
            "\uc0\u55357 \u57057 \u65039  **Informa\u539 ii Legale \u537 i Joc Responsabil**\\n\\n"\
            "\'95 Jocurile de tip Crash (cum este Aviator) func\uc0\u539 ioneaz\u259  pe algoritmi aleatorii (*Provably Fair*).\\n"\
            "\'95 Nicio inteligen\uc0\u539 \u259  artificial\u259  nu poate ghici sau garanta multiplicatori viitori.\\n"\
            "\'95 Seteaz\uc0\u259 -\u539 i un buget fix \u537 i nu juca niciodat\u259  bani pe care nu \'ee\u539 i permi\u539 i s\u259  \'eei pierzi."\
        )\
        keyboard = [[InlineKeyboardButton("\uc0\u55357 \u56601  \'cenapoi la Meniu", callback_data="back_start")]]\
        await query.edit_message_text(text=risk_text, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode="Markdown")\
