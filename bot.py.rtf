        "Acest bot genereaz\uc0\u259  analize de pruden\u539 \u259  **exclusiv la cererea ta**.\\n\\n"\
        "Apas\uc0\u259  pe butonul de mai jos sau folose\u537 te comanda **/semnal** pentru a primi o simulare statistic\u259 .\\n\\n"\
        "\uc0\u9888 \u65039  *Jocurile de noroc implic\u259  riscuri financiare majore. Nu exist\u259  garan\u539 ii de c\'e2\u537 tig.*"\
    )\
    await update.message.reply_text(welcome_text, reply_markup=reply_markup, parse_mode="Markdown")\
\
# Comanda direct\uc0\u259  /semnal\
async def semnal_command(update: Update, context: ContextTypes.DEFAULT_TYPE):\
