    server.serve_forever()\
\
# Func\uc0\u539 ie care apeleaz\u259  AI-ul DOAR c\'e2nd este solicitat\u259  la ap\u259 sare\
async def genereaza_analiza_text():\
    prompt = (\
        "Ac\uc0\u539 ioneaz\u259  ca un consultant responsabil de managementul riscului pentru jocuri de divertisment. "\
        "Genereaz\uc0\u259  un scurt mesaj \'een limba rom\'e2n\u259  care s\u259  con\u539 in\u259 : "\
        "1. O perspectiv\uc0\u259  statistic\u259  ipotetic\u259  de pruden\u539 \u259  (ex: recomandare de oprire timpurie la un coeficient mic de 1.2x - 1.4x). "\
        "2. Un avertisment ferm despre importan\uc0\u539 a pauzelor \u537 i a limit\u259 rii bugetului. "\
        "Fii concis, obiectiv \uc0\u537 i men\u539 ioneaz\u259  clar riscul."\
    )\
    try:\
        response = model.generate_content(prompt)\
        return response.text\
    except Exception as e:\
        return "Momentan serviciul de analiz\uc0\u259  AI nu este disponibil. V\u259  rug\u259 m reveni\u539 i mai t\'e2rziu."\
\
# Comanda /start - Meniul principal\
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):\
    keyboard = [\
