        await query.edit_message_text(\
            text="\uc0\u55358 \u56598  **Asistent Oficial de Analiz\u259  & Managementul Riscului**\\n\\nAlege o op\u539 iune de mai jos:",\
            reply_markup=InlineKeyboardMarkup(keyboard),\
            parse_mode="Markdown"\
        )\
        return\
\
    if query.data == "get_stats":\
        await query.edit_message_text(text="\uc0\u55357 \u56589  Se genereaz\u259  analiza cu AI...")\
        \
        ai_output = await genereaza_analiza_text()\
\
        final_message = (\
            f"\uc0\u55357 \u56522  **Buletin de Analiz\u259  \u537 i Pruden\u539 \u259 **\\n\\n"\
            f"\{ai_output\}\\n\\n"\
            f"\uc0\u9888 \u65039  *Joac\u259  responsabil! Limiteaz\u259 -\u539 i bugetul.*"\
        )\
        \
        keyboard = [[InlineKeyboardButton("\uc0\u55357 \u56580  Solicit\u259  o nou\u259  analiz\u259 ", callback_data="get_stats")]]\
        await query.edit_message_text(text=final_message, reply_markup=InlineKeyboardMarkup(keyboard), parse_mode="Markdown")\
\
def main():\
    # Pornim serverul web intern \'eentr-un fir separat (thread) pentru a ura Render fericit\
    threading.Thread(target=run_dummy_server, daemon=True).start()\
